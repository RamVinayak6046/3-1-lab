import java.util.Arrays;
import java.util.List;

public class Main {
    public static void main(String[] args) {

        List<Integer> salaries = Arrays.asList(10000, 20000, 30000, 40000, 50000);

        salaries.stream()
                .filter(salary -> salary > 20000)
                .forEach(System.out::println);
    }
}
